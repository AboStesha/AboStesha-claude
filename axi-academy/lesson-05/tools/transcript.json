[
{
"id": 0,
"a": 3.78,
"b": 8.92,
"text": "في هذا الدرس سنتعلّم ما هي الرسوم البيانية"
},
{
"id": 1,
"a": 9.08,
"b": 12.15,
"text": "عند التداول من المهم مراقبة أسعار أزواج العملات"
},
{
"id": 2,
"a": 12.37,
"b": 19.96,
"text": "ومن أبسط الطرق وأوضحها للقيام بذلك هي استخدام رسم بياني يعرض الأسعار الحالية والتاريخية"
},
{
"id": 3,
"a": 20.13,
"b": 22.98,
"text": "ولديك عدة خيارات للقيام بذلك"
},
{
"id": 4,
"a": 23.41,
"b": 28.71,
"text": "الخيار الأكثر شيوعاً بين المتداولين وأساس معظم الرسوم البيانية"
},
{
"id": 5,
"a": 28.9,
"b": 30.51,
"text": "هو الشموع اليابانية"
},
{
"id": 6,
"a": 30.77,
"b": 35.15,
"text": "سُمّيت بالشموع لأن الأسعار تُعرض على شكل يشبه الشموع"
},
{
"id": 7,
"a": 35.46,
"b": 36.94,
"text": "لكن كيف تعمل؟"
},
{
"id": 8,
"a": 37.15,
"b": 39.59,
"text": "ولماذا نبني منها رسوماً بيانية؟"
},
{
"id": 9,
"a": 40.13,
"b": 42.89,
"text": "بعد تحديد فترة زمنية معيّنة"
},
{
"id": 10,
"a": 43.08,
"b": 46.28,
"text": "تعرض الشمعة عدة نقاط سعرية مفيدة"
},
{
"id": 11,
"a": 46.52,
"b": 47.08,
"text": "وهي"
},
{
"id": 12,
"a": 47.43,
"b": 48.53,
"text": "سعر الافتتاح"
},
{
"id": 13,
"a": 48.7,
"b": 49.69,
"text": "وأعلى سعر"
},
{
"id": 14,
"a": 49.91,
"b": 50.95,
"text": "وأدنى سعر"
},
{
"id": 15,
"a": 51.11,
"b": 52.24,
"text": "وسعر الإغلاق"
},
{
"id": 16,
"a": 52.68,
"b": 56.76,
"text": "فإذا أغلق السعر أعلى من سعر الافتتاح خلال تلك الفترة"
},
{
"id": 17,
"a": 56.97,
"b": 59.06,
"text": "تظهر الشمعة باللون الأخضر"
},
{
"id": 18,
"a": 59.28,
"b": 61.27,
"text": "وإذا أغلق السعر أدنى منه"
},
{
"id": 19,
"a": 61.48,
"b": 63.06,
"text": "تكون الشمعة حمراء"
},
{
"id": 20,
"a": 63.35,
"b": 67.73,
"text": "ويظهر أعلى وأدنى سعر خلال الفترة على شكل ذيول"
},
{
"id": 21,
"a": 67.96,
"b": 70.32,
"text": "وعند دمج عدة شموع معاً"
},
{
"id": 22,
"a": 70.49,
"b": 75.48,
"text": "تتشكّل صورة واضحة لحركة أسعار ذلك الزوج من العملات"
},
{
"id": 23,
"a": 75.91,
"b": 77.87,
"text": "أما الرسم البياني الشريطي"
},
{
"id": 24,
"a": 78.09,
"b": 79.02,
"text": "فهو في الأساس"
},
{
"id": 25,
"a": 79.28,
"b": 82.2,
"text": "نسخة أنحف من الشمعة اليابانية"
},
{
"id": 26,
"a": 82.42,
"b": 83.56,
"text": "والرسم الخطي"
},
{
"id": 27,
"a": 83.73,
"b": 86.54,
"text": "يأخذ فعلياً سعر الإغلاق من الشمعة"
},
{
"id": 28,
"a": 86.71,
"b": 88.35,
"text": "ويرسم منه خطاً"
},
{
"id": 29,
"a": 88.77,
"b": 92.8,
"text": "ورغم أن بعض الرسوم البيانية أكثر شعبية من غيرها"
},
{
"id": 30,
"a": 92.97,
"b": 96.07,
"text": "لا يوجد رسم بياني واحد مضمون"
},
{
"id": 31,
"a": 96.25,
"b": 97.84,
"text": "أنه أفضل من الآخر"
},
{
"id": 32,
"a": 98.1,
"b": 101.53,
"text": "فالأمر كله يعتمد على أسلوبك في التداول"
},
{
"id": 33,
"a": 101.97,
"b": 105.99,
"text": "المتداولون الذين يفضّلون التركيز على أسعار الإغلاق"
},
{
"id": 34,
"a": 106.17,
"b": 108.42,
"text": "يميلون لاستخدام الرسم الخطي"
},
{
"id": 35,
"a": 108.68,
"b": 111.43,
"text": "أما من يفضّلون تحليل حركة السعر"
},
{
"id": 36,
"a": 111.63,
"b": 114.39,
"text": "فيميلون لاستخدام الشموع اليابانية"
},
{
"id": 37,
"a": 114.77,
"b": 118.11,
"text": "وتذكّر دائماً أنه أيّاً كان النوع الذي تختاره"
},
{
"id": 38,
"a": 118.47,
"b": 120.91,
"text": "فإن البيانات لا تكذب أبداً"
},
{
"id": 39,
"a": 121.28,
"b": 122.29,
"text": "فكل ما في الأمر"
},
{
"id": 40,
"a": 122.47,
"b": 126.4,
"text": "هو كيفية تفسير تلك الرسوم البيانية"
},
{
"id": 41,
"a": 126.62,
"b": 132.78,
"text": "قم بمراجعة الملف المرافق للدرس الذي يوضّح ما هي أنواع الرسوم البيانية بالتفصيل"
},
{
"id": 42,
"a": 133.23,
"b": 135.11,
"text": "ثم قم بالإجابة عن الأسئلة"
},
{
"id": 43,
"a": 135.4,
"b": 136.3,
"text": "في أسفل الصفحة"
},
{
"id": 44,
"a": 136.58,
"b": 138.44,
"text": "ونراكم في الدرس القادم"
},
{
"id": 45,
"a": 138.6,
"b": 139.39,
"text": "إن شاء الله"
}
]