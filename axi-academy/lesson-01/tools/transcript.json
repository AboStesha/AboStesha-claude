[
{
"id": 0,
"a": 3.78,
"b": 4.65,
"text": "إذن"
},
{
"id": 1,
"a": 4.84,
"b": 6.27,
"text": "ما هو الفوركس بالتحديد؟"
},
{
"id": 2,
"a": 6.72,
"b": 10.7,
"text": "الفوركس هو اختصار لسوق الصرف الأجنبي وهو ببساطة"
},
{
"id": 3,
"a": 10.93,
"b": 14.14,
"text": "الوسيلة التي تمكّننا من تبادل عملة بأخرى"
},
{
"id": 4,
"a": 14.53,
"b": 16.49,
"text": "تتغيّر قيمة الصرف باستمرار"
},
{
"id": 5,
"a": 16.77,
"b": 18.96,
"text": "حيث ترتفع قوة كل عملة"
},
{
"id": 6,
"a": 19.21,
"b": 20.99,
"text": "أو تنخفض داخل السوق"
},
{
"id": 7,
"a": 21.49,
"b": 22.71,
"text": "على سبيل المثال"
},
{
"id": 8,
"a": 22.93,
"b": 25.24,
"text": "لنفترض أن جون يعيش في أستراليا"
},
{
"id": 9,
"a": 25.44,
"b": 28.53,
"text": "وقرّر السفر في عطلة إلى الولايات المتحدة"
},
{
"id": 10,
"a": 28.76,
"b": 32.31,
"text": "يمتلك جون ألف دولار أسترالي كمصروف شخصي"
},
{
"id": 11,
"a": 32.51,
"b": 35.94,
"text": "لكنه يحتاج لتحويلها إلى دولار أمريكي"
},
{
"id": 12,
"a": 36.23,
"b": 37.3,
"text": "قبل مغادرته"
},
{
"id": 13,
"a": 37.75,
"b": 40.15,
"text": "يتّجه إلى مكتب صرافة محلي"
},
{
"id": 14,
"a": 40.39,
"b": 42.5,
"text": "ويحوّل الألف دولار أسترالي"
},
{
"id": 15,
"a": 42.76,
"b": 44.88,
"text": "إلى 700 دولار أمريكي"
},
{
"id": 16,
"a": 45.33,
"b": 46.55,
"text": "لسوء حظ جون"
},
{
"id": 17,
"a": 46.77,
"b": 50.89,
"text": "تتسبّب جائحة مفاجئة في إلغاء جميع الرحلات الجوية"
},
{
"id": 18,
"a": 51.18,
"b": 52.95,
"text": "ولم يعد بإمكانه السفر"
},
{
"id": 19,
"a": 53.75,
"b": 55.46,
"text": "فيعود إلى مكتب الصرافة"
},
{
"id": 20,
"a": 55.71,
"b": 58.24,
"text": "لإعادة تحويل الدولارات الأمريكية"
},
{
"id": 21,
"a": 58.5,
"b": 59.94,
"text": "إلى دولار أسترالي"
},
{
"id": 22,
"a": 60.41,
"b": 62.15,
"text": "وهنا كانت المفاجأة"
},
{
"id": 23,
"a": 62.51,
"b": 66.31,
"text": "الصرّاف يسلّم جون 1,100 دولار أسترالي"
},
{
"id": 24,
"a": 66.68,
"b": 68.49,
"text": "أي أكثر بمئة دولار"
},
{
"id": 25,
"a": 68.71,
"b": 70.26,
"text": "عمّا كان يتوقّعه"
},
{
"id": 26,
"a": 70.79,
"b": 74.73,
"text": "يخبر جون الصرّاف بأنه ربما ارتكب خطأً في الحسابات"
},
{
"id": 27,
"a": 74.96,
"b": 76.64,
"text": "لكن الصرّاف يشرح له"
},
{
"id": 28,
"a": 76.82,
"b": 81.72,
"text": "أنه نظراً لارتفاع قيمة الدولار الأمريكي منذ عملية التحويل الأولى"
},
{
"id": 29,
"a": 81.9,
"b": 84.08,
"text": "فإن 700 دولار أمريكي"
},
{
"id": 30,
"a": 84.33,
"b": 88.41,
"text": "أصبحت تساوي قيمة أكبر مقابل الدولار الأسترالي"
},
{
"id": 31,
"a": 89.36,
"b": 90.92,
"text": "حزن على إلغاء عطلته"
},
{
"id": 32,
"a": 91.13,
"b": 94.1,
"text": "إلا أنه اكتشف كيف يمكن استغلال الفوركس"
},
{
"id": 33,
"a": 94.33,
"b": 95.63,
"text": "لتحقيق الأرباح"
},
{
"id": 34,
"a": 95.96,
"b": 99.43,
"text": "وأنت أيضاً يمكنك تحقيق الأرباح من سوق الفوركس"
},
{
"id": 35,
"a": 99.71,
"b": 100.36,
"text": "ولكن"
},
{
"id": 36,
"a": 100.54,
"b": 101.98,
"text": "ليس بهذه البساطة"
},
{
"id": 37,
"a": 102.24,
"b": 105.45,
"text": "يجب عليك إكمال المنهاج التعليمي بالكامل"
},
{
"id": 38,
"a": 105.67,
"b": 108.04,
"text": "ابدأ فوراً بالإجابة على الأسئلة"
},
{
"id": 39,
"a": 108.25,
"b": 110.41,
"text": "التي ستجدها في أسفل الصفحة"
},
{
"id": 40,
"a": 110.63,
"b": 114.38,
"text": "كي تصبح أهلاً للانتقال إلى الدرس القادم"
},
{
"id": 41,
"a": 114.61,
"b": 115.41,
"text": "مع آكسي"
},
{
"id": 42,
"a": 115.63,
"b": 116.64,
"text": "تداول بثقة"
}
]