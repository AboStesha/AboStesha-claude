[
 {
  "id": 0,
  "a": 0.09,
  "b": 3.12,
  "text": "في هذا الدرس سنتعلّم كيف نحلّل الأسواق"
 },
 {
  "id": 1,
  "a": 3.31,
  "b": 6.72,
  "text": "وما هو التحليل الأساسي مقابل التحليل الفني؟"
 },
 {
  "id": 2,
  "a": 6.91,
  "b": 9.49,
  "text": "عندما يتعلّق الأمر بتحليل الصفقات"
 },
 {
  "id": 3,
  "a": 9.66,
  "b": 12.41,
  "text": "هناك نوعان رئيسيان من المتداولين"
 },
 {
  "id": 4,
  "a": 12.65,
  "b": 13.26,
  "text": "فأولاً"
 },
 {
  "id": 5,
  "a": 13.49,
  "b": 15.53,
  "text": "هناك المحلّلون الأساسيون"
 },
 {
  "id": 6,
  "a": 15.69,
  "b": 18.25,
  "text": "الذين يدرسون البيانات الاقتصادية"
 },
 {
  "id": 7,
  "a": 18.44,
  "b": 19.43,
  "text": "مثل التضخّم"
 },
 {
  "id": 8,
  "a": 19.6,
  "b": 21.44,
  "text": "والناتج المحلي الإجمالي"
 },
 {
  "id": 9,
  "a": 21.62,
  "b": 22.8,
  "text": "وأسعار الفائدة"
 },
 {
  "id": 10,
  "a": 22.96,
  "b": 25.06,
  "text": "لمحاولة التنبّؤ بالأسعار"
 },
 {
  "id": 11,
  "a": 25.24,
  "b": 26.06,
  "text": "وثانياً"
 },
 {
  "id": 12,
  "a": 26.24,
  "b": 28.14,
  "text": "هناك المحلّلون الفنيون"
 },
 {
  "id": 13,
  "a": 28.3,
  "b": 30.56,
  "text": "الذين يدرسون الرسوم البيانية"
 },
 {
  "id": 14,
  "a": 30.72,
  "b": 32.8,
  "text": "ويعتمدون في تنبّؤاتهم"
 },
 {
  "id": 15,
  "a": 32.97,
  "b": 36.15,
  "text": "على الرسومات والمؤشرات وأدوات أخرى"
 },
 {
  "id": 16,
  "a": 36.38,
  "b": 42.19,
  "text": "وتقليدياً يُستخدم التحليل الأساسي للتنبّؤ متوسط إلى طويل المدى"
 },
 {
  "id": 17,
  "a": 42.4,
  "b": 48.19,
  "text": "في حين يمكن للتحليل الفني التنبّؤ بكل شيء من المدى القصير جداً"
 },
 {
  "id": 18,
  "a": 48.36,
  "b": 49.09,
  "text": "إلى الطويل"
 },
 {
  "id": 19,
  "a": 49.25,
  "b": 54.23,
  "text": "ورغم اختلاف هاتين الطريقتين إلا أنهما يمكن أن تعملا معاً"
 },
 {
  "id": 20,
  "a": 54.39,
  "b": 59.23,
  "text": "بل إن المتداولين الناجحين يعرفون كيف يستفيدون من كلتيهما"
 },
 {
  "id": 21,
  "a": 59.46,
  "b": 69.02,
  "text": "فمثلاً للمساعدة في التنبّؤ بالاتجاه الذي ستسلكه عملة ما قد تبدأ بالنظر إلى الوضع الاقتصادي العام للدولة المعنية"
 },
 {
  "id": 22,
  "a": 69.25,
  "b": 76.22,
  "text": "ثم قد تنتقل إلى الرسم البياني لتتأكّد مما إذا كان تقييمك الأولي مدعوماً بالبيانات"
 },
 {
  "id": 23,
  "a": 76.43,
  "b": 78.63,
  "text": "فإذا اتفق كلا نوعي التحليل"
 },
 {
  "id": 24,
  "a": 78.79,
  "b": 81.82,
  "text": "يمكنك أن تكون أكثر ثقة في تقييمك"
 },
 {
  "id": 25,
  "a": 81.99,
  "b": 84.35,
  "text": "وتبدأ بتحديد نقاط الدخول"
 },
 {
  "id": 26,
  "a": 84.52,
  "b": 85.31,
  "text": "والخروج"
 },
 {
  "id": 27,
  "a": 85.72,
  "b": 87.21,
  "text": "ما هو التحليل الفني؟"
 },
 {
  "id": 28,
  "a": 87.66,
  "b": 89.85,
  "text": "التحليل الفني هو ببساطة"
 },
 {
  "id": 29,
  "a": 90.01,
  "b": 94.67,
  "text": "استخدام الرسوم البيانية لتفسير الاتجاه المحتمل للأسعار"
 },
 {
  "id": 30,
  "a": 94.83,
  "b": 96.22,
  "text": "وللقيام بذلك"
 },
 {
  "id": 31,
  "a": 96.38,
  "b": 100,
  "text": "يستخدم معظم المتداولين مؤشرات شائعة"
 },
 {
  "id": 32,
  "a": 100.16,
  "b": 104.15,
  "text": "مثل المتوسط المتحرك ومؤشر القوة النسبية"
 },
 {
  "id": 33,
  "a": 104.33,
  "b": 106.05,
  "text": "ومذبذب الاستوكاستك"
 },
 {
  "id": 34,
  "a": 106.21,
  "b": 107.44,
  "text": "وحزم بولنجر"
 },
 {
  "id": 35,
  "a": 107.62,
  "b": 108.37,
  "text": "وغيرها"
 },
 {
  "id": 36,
  "a": 108.55,
  "b": 113.99,
  "text": "وإذا لم تكن من محبي المؤشرات يمكنك دائماً اللجوء إلى الرسم اليدوي"
 },
 {
  "id": 37,
  "a": 114.16,
  "b": 116.4,
  "text": "يضيف كثير من المتداولين"
 },
 {
  "id": 38,
  "a": 116.57,
  "b": 122.12,
  "text": "خطوطاً أفقية وقطرية ومثلثات ومستطيلات وقنوات"
 },
 {
  "id": 39,
  "a": 122.29,
  "b": 130.41,
  "text": "وحتى أشكالاً حلزونية مباشرة على الرسوم البيانية للأسعار لمساعدتهم على تفسير الاتجاهات"
 },
 {
  "id": 40,
  "a": 130.75,
  "b": 136.87,
  "text": "وقد ترغب أيضاً في اتباع استراتيجية حركة السعر واستخدام الشموع اليابانية"
 },
 {
  "id": 41,
  "a": 137.03,
  "b": 138.45,
  "text": "لإضاءة تحليلك"
 },
 {
  "id": 42,
  "a": 138.63,
  "b": 144.67,
  "text": "أو يمكنك الجمع بين عدة أشكال من التحليل لمحاولة رؤية الصورة الأكبر"
 },
 {
  "id": 43,
  "a": 144.86,
  "b": 148.04,
  "text": "وأيّاً كان شكل التحليل الفني الذي تختاره"
 },
 {
  "id": 44,
  "a": 148.26,
  "b": 152.46,
  "text": "فالمهم اختيار الأداة المناسبة للصفقة المناسبة"
 },
 {
  "id": 45,
  "a": 152.63,
  "b": 155.22,
  "text": "والطريقة الوحيدة لتحقيق ذلك"
 },
 {
  "id": 46,
  "a": 155.41,
  "b": 156.46,
  "text": "هي الممارسة"
 },
 {
  "id": 47,
  "a": 157.08,
  "b": 158.75,
  "text": "ما هو التحليل الأساسي؟"
 },
 {
  "id": 48,
  "a": 159.32,
  "b": 160.73,
  "text": "المحلّل الأساسي"
 },
 {
  "id": 49,
  "a": 160.9,
  "b": 164.5,
  "text": "أشبه بطبيب يجري تقييماً صحياً عاماً"
 },
 {
  "id": 50,
  "a": 164.66,
  "b": 165.15,
  "text": "لكن"
 },
 {
  "id": 51,
  "a": 165.33,
  "b": 169.27,
  "text": "بينما يقيس الطبيب ضغط دمك ومستوى الكوليسترول"
 },
 {
  "id": 52,
  "a": 169.45,
  "b": 174.35,
  "text": "يراقب المحلّل الأساسي أموراً مثل الناتج المحلي الإجمالي"
 },
 {
  "id": 53,
  "a": 174.51,
  "b": 176.57,
  "text": "ومؤشر أسعار المستهلك"
 },
 {
  "id": 54,
  "a": 176.74,
  "b": 177.95,
  "text": "وأسعار الفائدة"
 },
 {
  "id": 55,
  "a": 178.11,
  "b": 180.02,
  "text": "لدولة أو اقتصاد ما"
 },
 {
  "id": 56,
  "a": 180.21,
  "b": 184.72,
  "text": "ومن خلال ذلك يمكنه تقييم ما إذا كان هذا الاقتصاد"
 },
 {
  "id": 57,
  "a": 184.88,
  "b": 191.86,
  "text": "في حالة جيدة أم لا وامتلاك هذه المعلومات يساعد في توجيه قراراتك التجارية"
 },
 {
  "id": 58,
  "a": 192.06,
  "b": 196.6,
  "text": "فإذا بدا أن دولة أو اقتصاداً يحقق أداءً جيداً"
 },
 {
  "id": 59,
  "a": 196.8,
  "b": 201.43,
  "text": "فستشتري العملة المرتبطة به وإذا كان أداؤه سيئاً"
 },
 {
  "id": 60,
  "a": 201.66,
  "b": 202.63,
  "text": "فستبيعها"
 },
 {
  "id": 61,
  "a": 203.04,
  "b": 205.45,
  "text": "فمن أين تحصل على هذه المعلومات؟"
 },
 {
  "id": 62,
  "a": 205.63,
  "b": 209.72,
  "text": "معظمها مُجدول ويمكن الاطلاع عليه بسهولة"
 },
 {
  "id": 63,
  "a": 209.88,
  "b": 211.85,
  "text": "من خلال التقويم الاقتصادي"
 },
 {
  "id": 64,
  "a": 212.01,
  "b": 216.61,
  "text": "الذي يعرض جميع الإصدارات المهمة للبيانات بما فيها"
 },
 {
  "id": 65,
  "a": 216.78,
  "b": 221.21,
  "text": "أرقام الناتج المحلي الإجمالي وقرارات أسعار الفائدة"
 },
 {
  "id": 66,
  "a": 221.38,
  "b": 231.3,
  "text": "وإذا جمعت هذه الأحداث الاقتصادية معاً يمكن استخدامها لتكوين تقييم شامل يشكّل الأساس لقراراتك التجارية"
 },
 {
  "id": 67,
  "a": 231.48,
  "b": 235.54,
  "text": "تذكّروا بأن التحليل الأساسي يخبرك ماذا تشتري"
 },
 {
  "id": 68,
  "a": 235.7,
  "b": 239.16,
  "text": "والتحليل الفني يخبرك متى تشتري"
 },
 {
  "id": 69,
  "a": 239.43,
  "b": 241.93,
  "text": "أجيبوا عن الأسئلة في أسفل الصفحة"
 },
 {
  "id": 70,
  "a": 242.09,
  "b": 243.88,
  "text": "ونراكم في الدرس القادم"
 },
 {
  "id": 71,
  "a": 244.04,
  "b": 244.93,
  "text": "إن شاء الله"
 }
]