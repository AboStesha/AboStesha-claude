[
 {
  "id": 0,
  "a": 0.07,
  "b": 4.52,
  "text": "لكي تكون ناجحاً في التداول من الضروري أن تمتلك استراتيجية"
 },
 {
  "id": 1,
  "a": 4.78,
  "b": 5.5,
  "text": "في هذا الدرس"
 },
 {
  "id": 2,
  "a": 5.78,
  "b": 6.94,
  "text": "سنجيب عن سؤال"
 },
 {
  "id": 3,
  "a": 7.25,
  "b": 9.86,
  "text": "لماذا تحتاج إلى استراتيجية تداول؟"
 },
 {
  "id": 4,
  "a": 10.48,
  "b": 13.88,
  "text": "تخيّل نفسك قائداً عسكرياً يستعد للحرب"
 },
 {
  "id": 5,
  "a": 14.17,
  "b": 14.97,
  "text": "فهذا يعني"
 },
 {
  "id": 6,
  "a": 15.21,
  "b": 16.9,
  "text": "امتلاك خطة شاملة"
 },
 {
  "id": 7,
  "a": 17.07,
  "b": 18.75,
  "text": "للتفوّق على الأسواق"
 },
 {
  "id": 8,
  "a": 18.98,
  "b": 21.06,
  "text": "وسيعتمد نجاحك النهائي"
 },
 {
  "id": 9,
  "a": 21.27,
  "b": 24.4,
  "text": "على كسب عدد كبير من المعارك الصغيرة"
 },
 {
  "id": 10,
  "a": 24.65,
  "b": 26.09,
  "text": "مع تقليل الخسائر"
 },
 {
  "id": 11,
  "a": 26.57,
  "b": 29.1,
  "text": "ومن المهم أن تدرك أن الخسائر"
 },
 {
  "id": 12,
  "a": 29.26,
  "b": 30.62,
  "text": "ستحدث لا محالة"
 },
 {
  "id": 13,
  "a": 30.97,
  "b": 32.8,
  "text": "فحتى أفضل المتداولين"
 },
 {
  "id": 14,
  "a": 33.02,
  "b": 34.56,
  "text": "لا يربحون في كل صفقة"
 },
 {
  "id": 15,
  "a": 34.84,
  "b": 35.6,
  "text": "وأحياناً"
 },
 {
  "id": 16,
  "a": 35.81,
  "b": 38.57,
  "text": "عليك ببساطة أن تتقبّل الخسارة"
 },
 {
  "id": 17,
  "a": 38.79,
  "b": 39.94,
  "text": "وتمضي قُدُماً"
 },
 {
  "id": 18,
  "a": 40.5,
  "b": 41.23,
  "text": "وبالمثل"
 },
 {
  "id": 19,
  "a": 41.48,
  "b": 43.34,
  "text": "إذا صادفت الظروف المواتية"
 },
 {
  "id": 20,
  "a": 43.59,
  "b": 44.55,
  "text": "فلا تتردّد"
 },
 {
  "id": 21,
  "a": 44.79,
  "b": 46.81,
  "text": "وهذا يعني في لغة التداول"
 },
 {
  "id": 22,
  "a": 47.06,
  "b": 48.95,
  "text": "أن تمتلك الثقة الكافية"
 },
 {
  "id": 23,
  "a": 49.17,
  "b": 50.59,
  "text": "لزيادة مخاطراتك"
 },
 {
  "id": 24,
  "a": 51.12,
  "b": 52.38,
  "text": "وفي جميع الأحوال"
 },
 {
  "id": 25,
  "a": 52.62,
  "b": 55.42,
  "text": "سيمتلك القائد الجيد مثلك دائماً"
 },
 {
  "id": 26,
  "a": 55.65,
  "b": 56.67,
  "text": "خطة بديلة"
 },
 {
  "id": 27,
  "a": 56.84,
  "b": 58.6,
  "text": "واستراتيجية للخروج"
 },
 {
  "id": 28,
  "a": 59.08,
  "b": 61.31,
  "text": "فليس عليك أن تخوض كل معركة"
 },
 {
  "id": 29,
  "a": 61.53,
  "b": 64.89,
  "text": "ولا بأس أن تنسحب مبكراً بخسائر صغيرة"
 },
 {
  "id": 30,
  "a": 65.2,
  "b": 66.7,
  "text": "إذا كان ذلك يعني"
 },
 {
  "id": 31,
  "a": 66.91,
  "b": 69.58,
  "text": "أن تبقى قادراً على القتال يوماً آخر"
 },
 {
  "id": 32,
  "a": 69.78,
  "b": 72.33,
  "text": "بدلاً من أن تُمحى تماماً من السوق"
 },
 {
  "id": 33,
  "a": 72.82,
  "b": 74.33,
  "text": "فرؤية الصورة الأكبر"
 },
 {
  "id": 34,
  "a": 74.56,
  "b": 77.01,
  "text": "جزء أساسي من خطة التداول"
 },
 {
  "id": 35,
  "a": 77.47,
  "b": 80.19,
  "text": "ما الذي تتضمّنه استراتيجية التداول؟"
 },
 {
  "id": 36,
  "a": 80.71,
  "b": 83.57,
  "text": "أنت تعلم أن استراتيجية التداول مهمة"
 },
 {
  "id": 37,
  "a": 83.86,
  "b": 86.17,
  "text": "لكن ما الذي يدخل في بنائها؟"
 },
 {
  "id": 38,
  "a": 86.85,
  "b": 88.79,
  "text": "الجزء السهل هو ببساطة"
 },
 {
  "id": 39,
  "a": 88.99,
  "b": 89.95,
  "text": "تحديد أهدافك"
 },
 {
  "id": 40,
  "a": 90.4,
  "b": 91.55,
  "text": "أما الجزء الصعب"
 },
 {
  "id": 41,
  "a": 91.81,
  "b": 94.86,
  "text": "فهو معرفة كيفية تحقيق تلك الأهداف"
 },
 {
  "id": 42,
  "a": 95.14,
  "b": 96.47,
  "text": "من خلال تداولك"
 },
 {
  "id": 43,
  "a": 96.87,
  "b": 98.68,
  "text": "ويتمحور معظم ذلك"
 },
 {
  "id": 44,
  "a": 98.91,
  "b": 101.31,
  "text": "حول استراتيجية الدخول والخروج"
 },
 {
  "id": 45,
  "a": 101.9,
  "b": 106.08,
  "text": "تحدّد استراتيجية الدخول الشروط التي يجب استيفاؤها"
 },
 {
  "id": 46,
  "a": 106.35,
  "b": 108.13,
  "text": "قبل أن تقرّر فتح صفقة"
 },
 {
  "id": 47,
  "a": 108.48,
  "b": 110.51,
  "text": "وقد تكون بسيطة جداً"
 },
 {
  "id": 48,
  "a": 110.81,
  "b": 113.93,
  "text": "كالشراء عندما يلامس السعر مستوى دعم"
 },
 {
  "id": 49,
  "a": 114.34,
  "b": 115.17,
  "text": "أو معقّدة"
 },
 {
  "id": 50,
  "a": 115.44,
  "b": 117.78,
  "text": "كأن يلامس السعر مستوى دعم"
 },
 {
  "id": 51,
  "a": 118.05,
  "b": 120.42,
  "text": "ويتقاطع مؤشر الاستوكاستك"
 },
 {
  "id": 52,
  "a": 120.68,
  "b": 122.13,
  "text": "تحت مستوى 20"
 },
 {
  "id": 53,
  "a": 122.37,
  "b": 123.39,
  "text": "ويكون السعر"
 },
 {
  "id": 54,
  "a": 123.58,
  "b": 125.24,
  "text": "داخل قناة صاعدة"
 },
 {
  "id": 55,
  "a": 125.77,
  "b": 128.03,
  "text": "فإذا لم تستوفِ الصفقة شروطك"
 },
 {
  "id": 56,
  "a": 128.33,
  "b": 130.64,
  "text": "فهي ليست جزءاً من استراتيجيتك"
 },
 {
  "id": 57,
  "a": 130.83,
  "b": 132.59,
  "text": "وعليك التفكير مرّتين"
 },
 {
  "id": 58,
  "a": 132.77,
  "b": 133.98,
  "text": "قبل الدخول فيها"
 },
 {
  "id": 59,
  "a": 134.49,
  "b": 136.41,
  "text": "وبمجرّد أن تفتح صفقة"
 },
 {
  "id": 60,
  "a": 136.66,
  "b": 138.77,
  "text": "يأتي دور استراتيجية الخروج"
 },
 {
  "id": 61,
  "a": 139.11,
  "b": 142.12,
  "text": "وهناك ثلاث طرق للخروج من الصفقة"
 },
 {
  "id": 62,
  "a": 142.39,
  "b": 143.08,
  "text": "بربح"
 },
 {
  "id": 63,
  "a": 143.27,
  "b": 144.12,
  "text": "أو بخسارة"
 },
 {
  "id": 64,
  "a": 144.37,
  "b": 145.96,
  "text": "أو عند نقطة التعادل"
 },
 {
  "id": 65,
  "a": 146.23,
  "b": 148.63,
  "text": "وعليك أن تمتلك خطة خروج"
 },
 {
  "id": 66,
  "a": 148.81,
  "b": 151.31,
  "text": "لكل سيناريو من هذه السيناريوهات"
 },
 {
  "id": 67,
  "a": 151.9,
  "b": 154.31,
  "text": "وكما هو الحال مع نقاط الدخول"
 },
 {
  "id": 68,
  "a": 154.53,
  "b": 157.17,
  "text": "يمكن أن تكون نقاط الخروج بسيطة"
 },
 {
  "id": 69,
  "a": 157.48,
  "b": 160.6,
  "text": "كجني الأرباح عند بلوغ مستوى مقاومة"
 },
 {
  "id": 70,
  "a": 160.88,
  "b": 161.73,
  "text": "أو معقّدة"
 },
 {
  "id": 71,
  "a": 161.99,
  "b": 164.23,
  "text": "وستختلف طريقة خروجك"
 },
 {
  "id": 72,
  "a": 164.47,
  "b": 165.67,
  "text": "المخطّط لها"
 },
 {
  "id": 73,
  "a": 165.84,
  "b": 167.14,
  "text": "باختلاف أهدافك"
 },
 {
  "id": 74,
  "a": 167.69,
  "b": 170.85,
  "text": "والمهم أن تتذكّر ضرورة الوضوح التام"
 },
 {
  "id": 75,
  "a": 171.06,
  "b": 173.7,
  "text": "بشأن استراتيجية الدخول والخروج"
 },
 {
  "id": 76,
  "a": 174.02,
  "b": 177.6,
  "text": "فتعتمد عليهما استراتيجيتك بأكملها"
 },
 {
  "id": 77,
  "a": 177.84,
  "b": 179.74,
  "text": "ونجاحك كمتداول"
 },
 {
  "id": 78,
  "a": 180.35,
  "b": 182.43,
  "text": "بناء استراتيجية تداولك"
 },
 {
  "id": 79,
  "a": 182.93,
  "b": 185.58,
  "text": "لبناء استراتيجية تداول فعّالة"
 },
 {
  "id": 80,
  "a": 185.83,
  "b": 187.26,
  "text": "فإن القاعدة الأولى"
 },
 {
  "id": 81,
  "a": 187.51,
  "b": 190.21,
  "text": "هي أن تكون واقعياً بشأن وقتك"
 },
 {
  "id": 82,
  "a": 190.59,
  "b": 196.02,
  "text": "فإذا كان لديك 30 دقيقة فقط من وقت فراغك يومياً للتداول"
 },
 {
  "id": 83,
  "a": 196.31,
  "b": 198.06,
  "text": "فلا تختر استراتيجية"
 },
 {
  "id": 84,
  "a": 198.26,
  "b": 200.04,
  "text": "تتطلّب ثماني ساعات"
 },
 {
  "id": 85,
  "a": 200.24,
  "b": 202.02,
  "text": "من تحليل الرسوم البيانية"
 },
 {
  "id": 86,
  "a": 202.53,
  "b": 204.81,
  "text": "وبمجرّد أن تحدّد توقيتك"
 },
 {
  "id": 87,
  "a": 205.03,
  "b": 206.85,
  "text": "ابدأ بالتفكير في المخاطرة"
 },
 {
  "id": 88,
  "a": 207.27,
  "b": 209.28,
  "text": "هل أنت شخص حذر جداً؟"
 },
 {
  "id": 89,
  "a": 209.53,
  "b": 211.61,
  "text": "أم تميل إلى تجاهل الحذر"
 },
 {
  "id": 90,
  "a": 211.82,
  "b": 213.33,
  "text": "سعياً وراء الأرباح؟"
 },
 {
  "id": 91,
  "a": 213.83,
  "b": 216.08,
  "text": "قيّم نفسك بعناية وصدق"
 },
 {
  "id": 92,
  "a": 216.3,
  "b": 218.23,
  "text": "لتحديد مقدار المخاطرة"
 },
 {
  "id": 93,
  "a": 218.46,
  "b": 220.86,
  "text": "التي تشعر بالارتياح تجاهها"
 },
 {
  "id": 94,
  "a": 221.35,
  "b": 225.03,
  "text": "فإذا كنت تستيقظ ليلاً قلقاً بشأن صفقاتك"
 },
 {
  "id": 95,
  "a": 225.31,
  "b": 228.84,
  "text": "فمن المرجّح أنك حدّدت مستوى مخاطرتك"
 },
 {
  "id": 96,
  "a": 229.03,
  "b": 230.06,
  "text": "بشكل خاطئ"
 },
 {
  "id": 97,
  "a": 230.69,
  "b": 231.51,
  "text": "بعد ذلك"
 },
 {
  "id": 98,
  "a": 231.68,
  "b": 233.48,
  "text": "حان وقت اختيار أسواقك"
 },
 {
  "id": 99,
  "a": 233.76,
  "b": 235.64,
  "text": "سواء كان ذلك الفوركس"
 },
 {
  "id": 100,
  "a": 235.81,
  "b": 236.43,
  "text": "أو النفط"
 },
 {
  "id": 101,
  "a": 236.68,
  "b": 237.42,
  "text": "أو الذهب"
 },
 {
  "id": 102,
  "a": 237.64,
  "b": 238.98,
  "text": "أو العملات الرقمية"
 },
 {
  "id": 103,
  "a": 239.19,
  "b": 240.55,
  "text": "أو أي شيء آخر"
 },
 {
  "id": 104,
  "a": 240.91,
  "b": 242.34,
  "text": "فلكل متداول"
 },
 {
  "id": 105,
  "a": 242.54,
  "b": 246.19,
  "text": "أسبابه الخاصة لاختيار منتجات تداول مختلفة"
 },
 {
  "id": 106,
  "a": 246.52,
  "b": 247.35,
  "text": "والمفتاح"
 },
 {
  "id": 107,
  "a": 247.52,
  "b": 249.08,
  "text": "هو أن تكون مهتماً"
 },
 {
  "id": 108,
  "a": 249.26,
  "b": 250.85,
  "text": "ومتابعاً للأخبار"
 },
 {
  "id": 109,
  "a": 251.04,
  "b": 254.71,
  "text": "حتى تتعلّم تفاصيل كل سوق ودقائقه"
 },
 {
  "id": 110,
  "a": 255.25,
  "b": 257.31,
  "text": "وهذا يقودنا إلى التحليل"
 },
 {
  "id": 111,
  "a": 257.68,
  "b": 261.78,
  "text": "هل تفضّل النظرة العامة التي يوفّرها التحليل الأساسي؟"
 },
 {
  "id": 112,
  "a": 262.1,
  "b": 264.75,
  "text": "أم تفضّل الغوص في الرسوم البيانية"
 },
 {
  "id": 113,
  "a": 264.94,
  "b": 266.34,
  "text": "عبر التحليل الفني"
 },
 {
  "id": 114,
  "a": 266.88,
  "b": 268.94,
  "text": "لموازنة استراتيجياتك؟"
 },
 {
  "id": 115,
  "a": 269.14,
  "b": 271.73,
  "text": "لماذا لا تجرّب مزيجاً من الاثنين؟"
 },
 {
  "id": 116,
  "a": 272.22,
  "b": 276.38,
  "text": "هنا لك كتاب كامل فيه أهم استراتيجيات التداول"
 },
 {
  "id": 117,
  "a": 276.59,
  "b": 278.15,
  "text": "وكيفية تطبيقها"
 },
 {
  "id": 118,
  "a": 278.54,
  "b": 279.57,
  "text": "اقرأ الكتاب"
 },
 {
  "id": 119,
  "a": 279.84,
  "b": 281.33,
  "text": "ثم أجيبوا عن الأسئلة"
 },
 {
  "id": 120,
  "a": 281.56,
  "b": 282.66,
  "text": "في أسفل الصفحة"
 },
 {
  "id": 121,
  "a": 282.93,
  "b": 284.67,
  "text": "ونراكم في الدرس القادم"
 },
 {
  "id": 122,
  "a": 284.86,
  "b": 285.93,
  "text": "إن شاء الله"
 }
]