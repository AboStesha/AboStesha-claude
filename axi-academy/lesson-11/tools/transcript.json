[
{
"id": 0,
"a": 3.78,
"b": 6.98,
"text": "هل تساءلت يوماً ما هو سعر الشراء والبيع؟"
},
{
"id": 1,
"a": 7.1,
"b": 9.87,
"text": "هما مستويا السعر اللذان تشتري أو تبيع"
},
{
"id": 2,
"a": 10.03,
"b": 12.15,
"text": "عندهما أداة تداول معيّنة"
},
{
"id": 3,
"a": 12.37,
"b": 13.16,
"text": "وباختصار"
},
{
"id": 4,
"a": 13.4,
"b": 14.45,
"text": "تُعِدّ صفقتك"
},
{
"id": 5,
"a": 14.67,
"b": 19.54,
"text": "وعندما يصل سعر السوق إلى سعر الشراء أو البيع الذي حدّدته مسبقاً"
},
{
"id": 6,
"a": 19.77,
"b": 20.92,
"text": "تُنفَّذ صفقتك"
},
{
"id": 7,
"a": 21.15,
"b": 22.58,
"text": "وستلاحظ أحياناً"
},
{
"id": 8,
"a": 22.75,
"b": 26.43,
"text": "أن سعري الشراء والبيع يُشار إليهما بسعر العرض"
},
{
"id": 9,
"a": 26.65,
"b": 27.62,
"text": "وسعر الطلب"
},
{
"id": 10,
"a": 27.94,
"b": 29.1,
"text": "وفي هذه الحالة"
},
{
"id": 11,
"a": 29.37,
"b": 31.37,
"text": "سعر العرض هو الذي تشتري به"
},
{
"id": 12,
"a": 31.63,
"b": 32.59,
"text": "وسعر الطلب"
},
{
"id": 13,
"a": 32.78,
"b": 34.02,
"text": "هو الذي تبيع به"
},
{
"id": 14,
"a": 34.37,
"b": 35.01,
"text": "والآن"
},
{
"id": 15,
"a": 35.2,
"b": 36.61,
"text": "قبل أن تنفّذ صفقة"
},
{
"id": 16,
"a": 36.84,
"b": 41.48,
"text": "عليك أن تقرّر ما إذا كنت تتوقّع ارتفاع السعر أو انخفاضه"
},
{
"id": 17,
"a": 41.8,
"b": 43.36,
"text": "فإذا توقّعت ارتفاعه"
},
{
"id": 18,
"a": 43.59,
"b": 45.22,
"text": "فستتّجه نحو الشراء"
},
{
"id": 19,
"a": 45.46,
"b": 47.16,
"text": "وإذا توقّعت انخفاضه"
},
{
"id": 20,
"a": 47.4,
"b": 48.98,
"text": "فستتّجه نحو البيع"
},
{
"id": 21,
"a": 49.35,
"b": 52.14,
"text": "لنفترض أنك قرّرت شراء أسهم آبل"
},
{
"id": 22,
"a": 52.33,
"b": 53.49,
"text": "الخطوة التالية"
},
{
"id": 23,
"a": 53.75,
"b": 56.31,
"text": "هي تحديد السعر الذي تريد الشراء عنده"
},
{
"id": 24,
"a": 56.54,
"b": 58.82,
"text": "وهذا هو سعر الشراء الخاص بك"
},
{
"id": 25,
"a": 59.14,
"b": 62.29,
"text": "فإذا أردت الشراء عند 150 دولاراً"
},
{
"id": 26,
"a": 62.53,
"b": 64.46,
"text": "كل ما عليك هو ضبط السعر"
},
{
"id": 27,
"a": 64.72,
"b": 67.42,
"text": "للشراء عند 150 دولاراً"
},
{
"id": 28,
"a": 67.72,
"b": 71.48,
"text": "وعندما يصل سعر السوق إلى سعر الشراء الذي حدّدته"
},
{
"id": 29,
"a": 71.68,
"b": 72.76,
"text": "سيُنفَّذ أمر"
},
{
"id": 30,
"a": 73.03,
"b": 73.54,
"text": "الشراء"
},
{
"id": 31,
"a": 73.86,
"b": 76.21,
"text": "والعكس صحيح بالنسبة للبيع"
},
{
"id": 32,
"a": 76.52,
"b": 78.58,
"text": "وباستخدام مثال آبل نفسه"
},
{
"id": 33,
"a": 78.77,
"b": 82.58,
"text": "إذا قرّرت بيع أسهم آبل عند 150 دولاراً"
},
{
"id": 34,
"a": 82.83,
"b": 86.42,
"text": "فاضبط سعر البيع عند 150 دولاراً"
},
{
"id": 35,
"a": 86.73,
"b": 90.2,
"text": "وفي اللحظة التي يصل فيها السوق إلى ذلك المستوى"
},
{
"id": 36,
"a": 90.38,
"b": 93.31,
"text": "ويتطابق مع سعر البيع الذي حدّدته"
},
{
"id": 37,
"a": 93.53,
"b": 95.45,
"text": "سيُنفَّذ أمر البيع"
},
{
"id": 38,
"a": 95.6,
"b": 98.19,
"text": "أجيبوا عن الأسئلة في أسفل الصفحة"
},
{
"id": 39,
"a": 98.36,
"b": 100.95,
"text": "ونراكم في الدرس القادم إن شاء الله"
}
]