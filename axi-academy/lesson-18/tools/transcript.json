[
{
"id": 0,
"a": 0.08,
"b": 3.46,
"text": "شنو أول سؤال لازم تسأله قبل ما تودع أول دولار؟"
},
{
"id": 1,
"a": 3.87,
"b": 5.4,
"text": "هذا الوسيط مرخّص لو لا؟"
},
{
"id": 2,
"a": 5.85,
"b": 7.65,
"text": "بهذا الدرس الأخير من السلسلة"
},
{
"id": 3,
"a": 7.82,
"b": 9.66,
"text": "راح نتعلم شلون تفحص الوسيط"
},
{
"id": 4,
"a": 9.98,
"b": 11.62,
"text": "وتتدرب على حساب تجريبي"
},
{
"id": 5,
"a": 11.88,
"b": 13.54,
"text": "وأخطاء المبتدئين الشائعة."
},
{
"id": 6,
"a": 14.04,
"b": 14.43,
"text": "جون،"
},
{
"id": 7,
"a": 14.66,
"b": 15.92,
"text": "شخصيتنا الخيالية،"
},
{
"id": 8,
"a": 16.12,
"b": 17.12,
"text": "عنده رأسمال قليل،"
},
{
"id": 9,
"a": 17.5,
"b": 22.1,
"text": "وشاف إن CFD تخليك تفتح صفقة بمبلغ أصغر من قيمة الصفقة"
},
{
"id": 10,
"a": 22.36,
"b": 23.26,
"text": "بالرافعة المالية."
},
{
"id": 11,
"a": 23.68,
"b": 26.6,
"text": "بس الرافعة المالية تكبّر الخسارة مثل الربح،"
},
{
"id": 12,
"a": 26.96,
"b": 27.99,
"text": "والرأسمال القليل"
},
{
"id": 13,
"a": 28.16,
"b": 29.26,
"text": "ممكن ينخسر بسرعة."
},
{
"id": 14,
"a": 29.71,
"b": 31.4,
"text": "وجون شديد الحذر بطبعه،"
},
{
"id": 15,
"a": 31.81,
"b": 34.01,
"text": "فقبل ما يختار وسيط سوّى تحرّي:"
},
{
"id": 16,
"a": 34.41,
"b": 35.73,
"text": "الوسيط مرخّص لو لا؟"
},
{
"id": 17,
"a": 36.11,
"b": 37.99,
"text": "والشركة اللي راح يفتحون بيها حسابه"
},
{
"id": 18,
"a": 38.18,
"b": 39.44,
"text": "تخضع لجهة تنظيمية؟"
},
{
"id": 19,
"a": 39.73,
"b": 41.97,
"text": "وشنو حماية العملاء وسمعة الوسيط؟"
},
{
"id": 20,
"a": 42.27,
"b": 44.6,
"text": "وهو يفحص سجل الجهة التنظيمية نفسها،"
},
{
"id": 21,
"a": 44.81,
"b": 45.89,
"text": "مو بس موقع الوسيط."
},
{
"id": 22,
"a": 46.16,
"b": 48.1,
"text": "والترخيص مو معناه ماكو خسارة،"
},
{
"id": 23,
"a": 48.41,
"b": 51.58,
"text": "والحماية ممكن تختلف حسب الكيان وبلد إقامتك."
},
{
"id": 24,
"a": 51.88,
"b": 52.84,
"text": "وبعد ما فحص،"
},
{
"id": 25,
"a": 53.03,
"b": 54.48,
"text": "اختار آكسي كوسيط."
},
{
"id": 26,
"a": 54.82,
"b": 56.73,
"text": "وجون خايف يغلط على MetaTrader،"
},
{
"id": 27,
"a": 57.01,
"b": 58.35,
"text": "فدوّر على حساب تجريبي،"
},
{
"id": 28,
"a": 58.66,
"b": 62.55,
"text": "ولگى إن آكسي توفر حساب تجريبي مجاني على MetaTrader"
},
{
"id": 29,
"a": 62.84,
"b": 63.58,
"text": "يتدرب بيه"
},
{
"id": 30,
"a": 63.79,
"b": 65.41,
"text": "قبل ما يستخدم فلوس حقيقية."
},
{
"id": 31,
"a": 65.8,
"b": 67.42,
"text": "وشلون تبدي بالحساب التجريبي؟"
},
{
"id": 32,
"a": 67.8,
"b": 69.86,
"text": "دوّر على الرمز اللي تريد تتدرب عليه،"
},
{
"id": 33,
"a": 70.12,
"b": 72.07,
"text": "واسمه يختلف من وسيط لوسيط،"
},
{
"id": 34,
"a": 72.33,
"b": 74.03,
"text": "وتضيفه لنافذة Market Watch"
},
{
"id": 35,
"a": 74.28,
"b": 75.48,
"text": "وتفتح مواصفاته"
},
{
"id": 36,
"a": 75.72,
"b": 77.36,
"text": "وتقرا حجم العقد والتكاليف."
},
{
"id": 37,
"a": 77.81,
"b": 78.42,
"text": "بس انتبه:"
},
{
"id": 38,
"a": 78.76,
"b": 81.07,
"text": "الحساب التجريبي مو نسخة طبق الأصل."
},
{
"id": 39,
"a": 81.4,
"b": 85.84,
"text": "التنفيذ ممكن يختلف وقت الأخبار وفتح السوق بعد عطلة نهاية الأسبوع."
},
{
"id": 40,
"a": 86.11,
"b": 90.11,
"text": "وبالتجريبي ممكن ما تشوف الانزلاق السعري والفجوات مثل الحقيقي."
},
{
"id": 41,
"a": 90.4,
"b": 91.91,
"text": "وماكو فلوس حقيقية،"
},
{
"id": 42,
"a": 92.21,
"b": 93.29,
"text": "فمشاعرك تختلف."
},
{
"id": 43,
"a": 93.83,
"b": 95.89,
"text": "أربعة أخطاء شائعة عند المبتدئين:"
},
{
"id": 44,
"a": 96.28,
"b": 96.77,
"text": "الأول:"
},
{
"id": 45,
"a": 97.11,
"b": 102.02,
"text": "تودع بحساب حقيقي بدون ما تتأكد من الوسيط وتفحص سجل الجهة التنظيمية."
},
{
"id": 46,
"a": 102.46,
"b": 102.96,
"text": "الثاني:"
},
{
"id": 47,
"a": 103.22,
"b": 105.26,
"text": "تفتح حساب حقيقي من أول يوم"
},
{
"id": 48,
"a": 105.44,
"b": 107.32,
"text": "بدون ما تتدرب على حساب تجريبي."
},
{
"id": 49,
"a": 107.69,
"b": 108.12,
