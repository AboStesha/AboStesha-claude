},
{
"id": 60,
"a": 126.88,
"b": 128.37,
"text": "أكو شغلات لازم تفحصها:"
},
{
"id": 61,
"a": 128.69,
"b": 129.22,
"text": "الوسيط،"
},
{
"id": 62,
"a": 129.47,
"b": 130.44,
"text": "والحساب التجريبي،"
},
{
"id": 63,
"a": 130.64,
"b": 131.66,
"text": "والأخطاء الشائعة."
},
{
"id": 64,
"a": 132.09,
"b": 136.87,
"text": "وبهذا نكون خلصنا سلسلة تعلّم التداول للمبتدئين من أكاديمية آكسي."
},
{
"id": 65,
"a": 137.2,
"b": 138.13,
