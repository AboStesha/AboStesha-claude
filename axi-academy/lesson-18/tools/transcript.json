},
{
"id": 52,
"a": 114.0,
"b": 115.01,
"text": "السبريد والسواب"
},
{
"id": 53,
"a": 115.21,
"b": 115.73,
"text": "والعمولة."
},
{
"id": 54,
"a": 116.1,
"b": 116.54,
